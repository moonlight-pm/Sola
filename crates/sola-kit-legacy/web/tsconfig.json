{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,

    // The vendored @remix-run/ui source under web/vendor/remix-ui/
    // imports its own modules with explicit `.ts` / `.tsx` extensions
    // (`import { … } from './foo.ts'`). Without this flag, every TS
    // resolution into the vendored tree fails with TS5097.
    "allowImportingTsExtensions": true,

    "types": [],

    // JSX runtime config. `react-jsx` selects the automatic runtime
    // (TS auto-imports `jsx`/`jsxs`/`Fragment` from
    // `<jsxImportSource>/jsx-runtime`), and `jsxImportSource` points
    // it at our vendored Remix v3. This must mirror what swc does at
    // request time in `crates/sola-kit/src/strip.rs` (`runtime:
    // Automatic`, `import_source: "@remix-run/ui"`) so the editor
    // and runtime agree on the same factory.
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/ui",

    "paths": {
      "@sola/ipc": ["./lib/ipc.ts"],
      "@sola/kit": ["./lib/kit.ts"],
      "@sola/bindings-editor": ["./lib/components/bindings-editor.tsx"],
      "@sola/button": ["./lib/components/button.tsx"],
      "@sola/card": ["./lib/components/card.tsx"],
      "@sola/color-picker": ["./lib/components/color-picker.tsx"],
      "@sola/container": ["./lib/components/container.tsx"],
      "@sola/field": ["./lib/components/field.tsx"],
      "@sola/font-input": ["./lib/components/font-input.tsx"],
      "@sola/number-input": ["./lib/components/number-input.tsx"],
      "@sola/popover": ["./lib/components/popover.tsx"],
      "@sola/popover-select": ["./lib/components/popover-select.tsx"],
      "@sola/root": ["./lib/components/root.tsx"],
      "@sola/sidebar": ["./lib/components/sidebar.tsx"],
      "@sola/split": ["./lib/components/split.tsx"],
      "@sola/stack": ["./lib/components/stack.tsx"],
      "@sola/swatch": ["./lib/components/swatch.tsx"],
      "@sola/text": ["./lib/components/text.tsx"],
      "@sola/text-input": ["./lib/components/text-input.tsx"],
      "@sola/token-value-editor": ["./lib/components/token-value-editor.tsx"],
      // Per-app root component. The kit's built-in `index.tsx`
      // imports `Main` via this specifier; the runtime importmap
      // injection (in `crates/sola-kit/src/lib.rs::build_importmap`)
      // wires it to the URL declared on `SolaApp::ROOT_COMPONENT`.
      // For LSP resolution we point at the storybook's main file —
      // other kit-using apps will declare their own override here.
      "@sola/app-root": ["./app/main.tsx"],
      "@chenglou/pretext": ["./vendor/pretext/dist/layout.d.ts"],
      "@remix-run/ui": ["./vendor/remix-ui/index.ts"],
      "@remix-run/ui/jsx-runtime": ["./vendor/remix-ui/jsx-runtime.ts"],
      "@remix-run/ui/*": ["./vendor/remix-ui/*"],
      "~/*": ["./lib/*"],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
}
