{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    "paths": {
      "preact": ["./vendor/preact/preact.d.ts"],
      "preact/jsx-runtime": ["./vendor/preact/jsx-runtime.d.ts"],
      "preact/hooks": ["./vendor/preact/hooks.d.ts"],
      "@preact/signals-core": ["./vendor/preact/signals-core.d.ts"],
      "@preact/signals": ["./vendor/preact/signals.d.ts"],
      "@sola/ipc": ["./lib/ipc.ts"],
      "~/*": ["./lib/*"],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
}
