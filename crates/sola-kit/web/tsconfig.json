{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@sola/ipc": ["./lib/ipc.ts"],
      "@remix-run/ui": ["./vendor/remix-ui/index.ts"],
      "@remix-run/ui/jsx-runtime": ["./vendor/remix-ui/jsx-runtime.ts"],
      "@remix-run/ui/*": ["./vendor/remix-ui/*"],
      "~/*": ["./lib/*"],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
}
