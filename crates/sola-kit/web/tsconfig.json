{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@arrow-js/core": ["./vendor/arrow/index.d.ts"],
      "@sola/ipc": ["./lib/ipc.ts"],
      "@sola/store": ["./lib/store.ts"],
      "@sola/kit": ["./lib/kit.ts"],
      "~/*": ["./lib/*"]
    }
  },
  "include": ["app/src/**/*.ts", "lib/**/*.ts"]
}
