## GET /manual — the manual (docs/manual) as one page.

import { Page, repository } from "~/app/ui/page"
import markdown, { Chapter, Heading } from "~/app/markdown"
import config from "~/app/config"
import { readFile } from "std/io"
import http, { Request, Response } from "std/http"
import { Pass, Fail } from "std/fallible"
import { warn } from "std/logging"

## Chapter files, in page order. docs/manual/README.md lists the same.
export let names = [
    "introduction",
    "distribution",
    "sola-shell",
    "sola-browser",
    "sola-mail",
    "sola-calendar",
    "sola-spotify",
    "sola-arcade",
    "sola-paint",
    "sola-preview",
    "sola-wrapper",
    "sola-design",
    "sola-monitor",
    "sola-scope",
    "sola-kvm-operator",
    "solactl",
]

type Loaded(chapter: Chapter, text: String, headings: Array<Heading>)

export fn page(request!: Request) -> Response {
    let loaded = load()
    http.htmlResponse(
        <Page title="Manual · Sola" request={request} current="manual">
            <div class="manual" id="main">
                <nav class="contents" aria-label="Contents">
                    <p class="contents-title">Contents</p>
                    {contents(loaded)}
                </nav>
                <article class="manual-body">
                    <header class="manual-head">
                        <h1>The Sola Manual</h1>
                        <p>
                            How to set Sola up and use its shell and applications, as they
                            work today. Built from <a href={"{repository}/tree/master/docs/manual"}>docs/manual</a>
                            in the repository; a change in behaviour changes these pages in
                            the same commit. Terminal, Workspaces, and Settings have no
                            chapter yet.
                        </p>
                        <details class="contents-inline">
                            <summary>Contents</summary>
                            {contents(loaded)}
                        </details>
                    </header>
                    {for entry in loaded {
                        <section class="chapter">{markdown.render(entry.text, entry.chapter, entry.headings)}</section>
                    }}
                </article>
            </div>
        </Page>
    )
}

## Read every chapter. A chapter that cannot be read is left out and logged.
fn load() -> Array<Loaded> {
    let directory = config.manualRoot()
    mut loaded: Array<Loaded> = []
    mut number = 0
    for name in names {
        match readFile("{directory}/{name}.md") {
            Fail(error) => warn("manual: {name}.md: {error}")
            Pass(bytes) {
                number = number + 1
                let chapter = Chapter(name, chapters: names, directory: "docs/manual", page: "")
                let text = bytes.toString()
                loaded.append(Loaded(chapter, text, headings: markdown.headings(text, chapter, number)))
            }
        }
    }
    loaded
}

## Chapters and their sections.
fn contents(loaded!: Array<Loaded>) -> Node {
    <ol class="toc">
        {for entry in loaded { chapterEntry(entry) }}
    </ol>
}

fn chapterEntry(entry!: Loaded) -> Node {
    mut sections: Array<Node> = []
    mut top: Array<Node> = []
    for heading in entry.headings {
        if heading.level == 1 {
            top.append(link(heading, entry.chapter))
        } else if heading.level == 2 {
            sections.append(<li>{link(heading, entry.chapter)}</li>)
        }
    }
    <li>
        {top}
        <ol>{sections}</ol>
    </li>
}

fn link(heading!: Heading, chapter!: Chapter) -> Node {
    <a href={"#{heading.id}"}>
        <span class="number">{heading.number}</span>
        {markdown.title(heading, chapter)}
    </a>
}
