## GET / and the not-found page.

import { Page, repository } from "~/app/ui/page"
import http, { Request, Response } from "std/http"

export fn page(request!: Request) -> Response {
    http.htmlResponse(
        <Page title="Sola" request={request} current="home">
            <main class="home" id="main">
                {intro()}
                {desk()}
                {design()}
                {applications()}
                {architecture()}
                {status()}
                {building()}
            </main>
        </Page>
    )
}

export fn missing(request!: Request) -> Response {
    http.htmlResponseStatus(
        404,
        "Not Found",
        <Page title="Not found · Sola" request={request}>
            <main class="home missing" id="main">
                <h1>Not found</h1>
                <p>There is no page at this address. Try the <a href="/">home page</a> or the <a href="/manual">manual</a>.</p>
            </main>
        </Page>
    )
}

fn intro() -> Node {
    <header class="intro">
        <h1><span class="mark" aria-hidden="true"></span>Sola</h1>
        <p class="lede">
            A desktop environment for Linux on Wayland, written in Rust. Sola runs the
            session, the shell, and its own applications, all drawn with one toolkit and
            one theme. River is the compositor.
        </p>
        <p class="facts">
            <span>Pre-release</span>
            <span>NixOS, x86-64</span>
            <span>No releases yet</span>
            <a href="/manual">Manual</a>
            <a href={repository}>Source</a>
        </p>
    </header>
}

fn desk() -> Node {
    <figure class="desk">
        <img
            src="/desk.png"
            width="1296"
            height="760"
            alt="The Sola desk: a menubar across the top; Projects with a Claude Code session waiting on a build; Mail with a letter open; a notification card; a floating Preview window."
        />
        <figcaption>
            The desk, drawn at 1:1 in Sola's
            <a href={"{repository}/blob/master/design/foundation/07-desk.html"}>design foundation</a>:
            Projects and Mail in zones, Preview floating.
        </figcaption>
    </figure>
}

## A command and what it does, for code blocks.
type Line(command: String, note: String)

fn controlLines() -> Array<Line> {
    [
        Line(command: "solactl compositor windows          ", note: "# every window, by application"),
        Line(command: "solactl compositor screenshot       ", note: "# the screen, as PNG"),
        Line(command: "solactl browser tabs                ", note: "# id, URL, and title of each tab"),
        Line(command: "solactl open https://example.com    ", note: "# in Sola's browser"),
        Line(command: "claude mcp add sola -- solactl mcp  ", note: "# every live method as an MCP tool"),
    ]
}

fn codeLine(line!: Line) -> Node {
    <span>{line.command}<span class="tk-cm">{line.note}</span>{"\n"}</span>
}

fn design() -> Node {
    <section id="design">
        <h2>Design</h2>
        <p>
            <strong>One toolkit for the whole desktop.</strong>
            The shell and every first-party application are Iced programs built on
            sola-kit, which supplies the buttons, fields, sidebars, menus, type roles,
            and colors. The theme travels on Sola's bus: change a color or a font and
            every running application redraws with it, without a restart.
        </p>
        <p>
            <strong>Separate processes, each restartable.</strong>
            A process manager, <code>sola</code>, supervises the event bus, the
            request/reply host, the bridge to the compositor, the shell, and the session
            manager. When one of them exits it is started again, and the rest of the
            session carries on. Applications are separate processes too, and they
            reconnect when the bus or the compositor bridge comes back.
        </p>
        <p>
            <strong>Native, not web.</strong>
            The shell and the applications draw with Iced on the GPU. There is no HTML in
            the desktop's own interface. A web engine (Chromium, through CEF) runs only
            where web pages are the content: the browser, website wrappers, and Design's
            artboards.
        </p>
        <p>
            <strong>Scriptable, by people and by agents.</strong>
            Each application registers its methods with the request/reply host, and
            <a href="/manual#solactl"><code>solactl</code></a> calls them from a shell.
            <code>solactl mcp</code> offers every live method to an AI agent as an MCP
            tool; the list changes as applications start and quit.
        </p>
        <pre><code>{for line in controlLines() { codeLine(line) }}</code></pre>
    </section>
}

type Entry(name: String, detail: String)

fn appList() -> Array<Entry> {
    [
        Entry(name: "Shell", detail: "Menubar with application menus and system status, launcher (Super+Space), window switcher (Super+Tab), notifications, and window zones."),
        Entry(name: "Terminal", detail: "A terminal on Alacritty's grid, with tabs."),
        Entry(name: "Projects", detail: "Projects and their git worktrees in a rail, one tab per checkout, each with terminal panes. A pane shows whether the coding agent in it (Claude Code, Codex, Grok) is working, waiting, or done."),
        Entry(name: "Browser", detail: "Chromium's engine under Sola's own chrome: a window per page, profiles, a Bitwarden vault, downloads, and developer tools."),
        Entry(name: "Mail", detail: "IMAP and SMTP for several accounts, with drafts and attachments."),
        Entry(name: "Calendar", detail: "Month, week, and day views of local, Google, and iCloud calendars, with reminders."),
        Entry(name: "Settings", detail: "Applications in the launcher, website wrappers, and mail and calendar accounts."),
        Entry(name: "Arcade", detail: "The Steam library in a window. Each game runs in a nested session sized to it."),
        Entry(name: "Spotify", detail: "Playback through librespot, playlists, the library, and Spotify Connect."),
        Entry(name: "Paint", detail: "The default image viewer and editor."),
        Entry(name: "Preview", detail: "A quick viewer for screenshots and images."),
        Entry(name: "Design", detail: "HTML artboards on a canvas, written and edited by AI agents."),
        Entry(name: "Wrappers", detail: "A website as an application of its own, with a launcher entry and desktop notifications."),
        Entry(name: "Monitor", detail: "A live view of bus traffic and of the methods each application offers."),
        Entry(name: "Scope", detail: "A pixel loupe: the screen under the pointer, magnified."),
        Entry(name: "KVM", detail: "One keyboard and mouse across two machines, with a shared clipboard."),
    ]
}

fn applications() -> Node {
    <section id="applications">
        <h2>Applications</h2>
        <p>
            Each is its own process and its own window. The shell is stable in daily use;
            the applications are early, and each is incomplete.
            <a href={"{repository}/blob/master/docs/capabilities.md"}>docs/capabilities.md</a>
            lists what each can do and what it lacks.
        </p>
        <dl class="entries">
            {for app in appList() {
                <div>
                    <dt>{app.name}</dt>
                    <dd>{app.detail}</dd>
                </div>
            }}
        </dl>
    </section>
}

## A process of the session and the manual chapter that covers it.
type Part(name: String, role: String, chapter: String)

fn partList() -> Array<Part> {
    [
        Part(name: "sola", role: "Process manager. Starts each component below and restarts any that exits.", chapter: "process-manager"),
        Part(name: "sola-bus", role: "Event bus on a Unix socket. Fans facts out to every client: focus, windows, the theme, application menus.", chapter: "bus"),
        Part(name: "sola-call", role: "Request/reply host. Applications register methods; solactl and agents call them.", chapter: "call"),
        Part(name: "sola-river", role: "Window manager for River, the Wayland compositor, and its bridge to the bus.", chapter: "compositor"),
        Part(name: "sola-session", role: "Launches applications and tracks them.", chapter: "session"),
        Part(name: "sola-shell", role: "Menubar, launcher, switcher, and notifications, in one Iced program.", chapter: "sola-shell"),
        Part(name: "sola-kit", role: "The shared Iced toolkit and the theme every application follows.", chapter: "theme"),
    ]
}

fn architecture() -> Node {
    <section id="architecture">
        <h2>Architecture</h2>
        <p>
            A session is these processes, plus one for each application that is open.
            The <a href="/manual#architecture">manual</a> covers each in full: sockets,
            wire formats, topics, restart rules, and the command line.
        </p>
        <dl class="entries parts">
            {for part in partList() {
                <div>
                    <dt><a href={"/manual#{part.chapter}"}><code>{part.name}</code></a></dt>
                    <dd>{part.role}</dd>
                </div>
            }}
        </dl>
    </section>
}

fn status() -> Node {
    <section id="status">
        <h2>Status</h2>
        <p>
            Sola is pre-release. It is developed on, and used every day on, one NixOS
            workstation. There are no releases or install images. Not there yet:
        </p>
        <ul>
            <li>Releases. Build from source; x86-64 is the only platform.</li>
            <li>An install image. The ISO and its installer are tested in a virtual machine and not published.</li>
            <li>Other distributions. The binaries expect NixOS paths, and Nix on another distribution is not supported.</li>
            <li>Complete applications. Each has gaps, and the capability list names them.</li>
        </ul>
        <p>
            The work under way is in
            <a href={"{repository}/blob/master/CURRENT.md"}>CURRENT.md</a>, and what each
            part can do in
            <a href={"{repository}/blob/master/docs/capabilities.md"}>docs/capabilities.md</a>.
        </p>
    </section>
}

fn buildLines() -> Array<Line> {
    [
        Line(command: "git clone https://github.com/moonlight-pm/Sola", note: ""),
        Line(command: "cd Sola", note: ""),
        Line(command: "cargo make install-cef   ", note: "# the browser engine, once"),
        Line(command: "cargo make install       ", note: "# every component, to /opt/sola/bin"),
        Line(command: "/opt/sola/bin/sola       ", note: "# from a TTY"),
    ]
}

fn building() -> Node {
    <section id="building">
        <h2>Building</h2>
        <p>
            You need NixOS on x86-64, an NVIDIA or Mesa graphics stack (Mesa needs one
            setting; see the manual), and Rust 1.85 or later. Sola's NixOS module prepares the host: the patched River, the
            libraries the browser engine loads, and the fonts. Then, from a clone:
        </p>
        <pre><code>{for line in buildLines() { codeLine(line) }}</code></pre>
        <p>
            The <a href="/manual#introduction">manual's introduction</a> covers the module,
            starting a session, and updating.
        </p>
    </section>
}
