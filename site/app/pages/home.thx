## GET / and the not-found page.

import { Page, repository } from "~/app/ui/page"
import http, { Request, Response } from "std/http"

export fn page(request!: Request) -> Response {
    http.htmlResponse(
        <Page title="Sola" request={request} current="home">
            <main class="home" id="main">
                {intro()}
                {desk()}
                {design()}
                {applications()}
                {architecture()}
                {status()}
                {building()}
            </main>
        </Page>
    )
}

export fn missing(request!: Request) -> Response {
    http.htmlResponseStatus(
        404,
        "Not Found",
        <Page title="Not found · Sola" request={request}>
            <main class="home missing" id="main">
                <h1>Not found</h1>
                <p>There is no page at this address. Try the <a href="/">home page</a> or the <a href="/manual">manual</a>.</p>
            </main>
        </Page>
    )
}

fn intro() -> Node {
    <header class="intro">
        <h1><span class="mark" aria-hidden="true"></span>Sola</h1>
        <p class="lede">
            A desktop environment for Linux on Wayland, written in Rust. Sola runs the
            session, the shell, and its own applications, all drawn with one toolkit and
            one theme. The compositor is rivulet, Oath's port of River.
        </p>
        <p class="facts">
            <span>Pre-release</span>
            <span>Oath, x86-64</span>
            <span>No releases yet</span>
            <a href="/manual">Manual</a>
            <a href={repository}>Source</a>
        </p>
    </header>
}

fn desk() -> Node {
    <figure class="desk">
        <img
            src="/desk.webp"
            width="1920"
            height="1080"
            alt="The Sola desk on Oath over a violet picture of raindrops on glass: the top row of status across the top; the bar on the left, the workspace Main at its head and its windows below; a Projects window with a Claude Code session at work; Settings open on Appearance."
        />
        <figcaption>
            The desk on Oath, 2026-10-29. The bar on the left lists the windows
            of the workspace Main; Projects runs Claude Code beside Settings on
            Appearance.
        </figcaption>
    </figure>
}

## A command and what it does, for code blocks.
type Line(command: String, note: String)

fn controlLines() -> Array<Line> {
    [
        Line(command: "solactl compositor windows          ", note: "# every window, by application"),
        Line(command: "solactl compositor screenshot       ", note: "# the screen, as PNG"),
        Line(command: "solactl browser tabs                ", note: "# id, URL, and title of each page"),
        Line(command: "solactl open https://example.com    ", note: "# in Sola's browser"),
        Line(command: "claude mcp add sola -- solactl mcp  ", note: "# every live method as an MCP tool"),
    ]
}

fn codeLine(line!: Line) -> Node {
    <span>{line.command}<span class="tk-cm">{line.note}</span>{"\n"}</span>
}

fn design() -> Node {
    <section id="design">
        <h2>Design</h2>
        <p>
            <strong>One toolkit for the whole desktop.</strong>
            The shell and every first-party application are Iced programs built on
            sola-kit, which supplies the buttons, fields, sidebars, menus, type roles,
            and colors. The theme travels on Sola's bus: change a color or a font and
            every running application redraws with it, without a restart.
        </p>
        <p>
            <strong>Separate processes, each restartable.</strong>
            Oath's PID 1 runs the event bus, the request/reply host, the window manager,
            the shell, and the session manager as services. When one of them fails it is
            started again, and the rest of the session carries on. Applications are
            separate processes too, and they reconnect when the bus or the window
            manager comes back.
        </p>
        <p>
            <strong>Native, not web.</strong>
            The shell and the applications draw with Iced on the GPU. There is no HTML in
            the desktop's own interface. A web engine (Chromium, through CEF) runs only
            where web pages are the content: the browser, the web apps it hosts, and
            Design's artboards.
        </p>
        <p>
            <strong>Scriptable, by people and by agents.</strong>
            Each application registers its methods with the request/reply host, and
            <a href="/manual#solactl"><code>solactl</code></a> calls them from a shell.
            <code>solactl mcp</code> offers every live method to an AI agent as an MCP
            tool; the list changes as applications start and quit.
        </p>
        <pre><code>{for line in controlLines() { codeLine(line) }}</code></pre>
    </section>
}

type Entry(name: String, detail: String)

fn appList() -> Array<Entry> {
    [
        Entry(name: "Shell", detail: "The top row (system status, missed notifications, and an island for each agent that asks or finishes), the bar of windows on the left with the desktop workspaces at its head (Super+1…9), the launcher (Super+Space), and window zones."),
        Entry(name: "Terminal", detail: "A terminal on Alacritty's grid: a window per tab, split panes, each in tmux."),
        Entry(name: "Projects", detail: "A window per project, its tabs (the checkout and its git worktrees) along the top, each with terminal panes. A tab shows whether the coding agent in it (Claude Code, Codex, Grok) is working, waiting, or done."),
        Entry(name: "Browser", detail: "Chromium's engine under Sola's own chrome: a window per page, a profile per workspace, a Bitwarden vault, downloads, and developer tools."),
        Entry(name: "Mail", detail: "IMAP and SMTP for several accounts, with drafts and attachments."),
        Entry(name: "Calendar", detail: "Month, week, and day views of local, Google, and iCloud calendars, with reminders."),
        Entry(name: "Web apps", detail: "A website the browser runs as an application of its own, wrapped from one of its pages: a launcher entry, its own windows and menus."),
        Entry(name: "Settings", detail: "Appearance (light or dark for web pages, the background picture and the colors taken from it, the desk's opacity, the idle fade), applications in the launcher, and mail and calendar accounts."),
        Entry(name: "Paint", detail: "The default image viewer and editor, a window per image; it sets the background picture."),
        Entry(name: "Design", detail: "HTML artboards on a canvas, written and edited by AI agents: a window per project."),
        Entry(name: "Oath", detail: "Oath's packages: turn one on or off and apply, or undo the last change."),
        Entry(name: "KVM", detail: "One keyboard and mouse across two machines, with a shared clipboard. Paired machines seal every packet with a shared key and drop what they did not seal."),
    ]
}

fn applications() -> Node {
    <section id="applications">
        <h2>Applications</h2>
        <p>
            Each is its own process, with its menus in its windows' titlebars. The shell is
            stable in daily use; the applications are early, and each is incomplete.
            Monitor, Preview, Scope, Spotify, and Arcade are in the repository but not yet
            in the Oath packages.
            <a href={"{repository}/blob/next/docs/capabilities.md"}>docs/capabilities.md</a>
            lists what each can do and what it lacks.
        </p>
        <dl class="entries">
            {for app in appList() {
                <div>
                    <dt>{app.name}</dt>
                    <dd>{app.detail}</dd>
                </div>
            }}
        </dl>
    </section>
}

## A process of the session and the manual chapter that covers it.
type Part(name: String, role: String, chapter: String)

fn partList() -> Array<Part> {
    [
        Part(name: "PID 1", role: "Oath's init. Runs rivulet and each component below as a service of the desk user, and restarts one that fails.", chapter: "process-manager"),
        Part(name: "sola-bus", role: "Event bus on a Unix socket. Fans facts out to every client: focus, windows, the theme, application menus.", chapter: "bus"),
        Part(name: "sola-call", role: "Request/reply host. Applications register methods; solactl and agents call them.", chapter: "call"),
        Part(name: "sola-river", role: "Window manager for River's protocol (rivulet on Oath), and its bridge to the bus.", chapter: "compositor"),
        Part(name: "sola-session", role: "Launches applications and tracks them.", chapter: "session"),
        Part(name: "sola-shell", role: "The top row, the bar of windows, the launcher, and notifications, in one Iced program.", chapter: "sola-shell"),
        Part(name: "sola-kit", role: "The shared Iced toolkit and the theme every application follows.", chapter: "theme"),
    ]
}

fn architecture() -> Node {
    <section id="architecture">
        <h2>Architecture</h2>
        <p>
            A session is these processes, plus one for each application that is open.
            The <a href="/manual#architecture">manual</a> covers each in full: sockets,
            wire formats, topics, restart rules, and the command line.
        </p>
        <dl class="entries parts">
            {for part in partList() {
                <div>
                    <dt><a href={"/manual#{part.chapter}"}><code>{part.name}</code></a></dt>
                    <dd>{part.role}</dd>
                </div>
            }}
        </dl>
    </section>
}

fn status() -> Node {
    <section id="status">
        <h2>Status</h2>
        <p>
            Sola is pre-release. It runs every day on
            <a href="https://oath.moonlight.pm">Oath</a>, which carries it as three
            packages built from this repository's <code>next</code> branch:
            <code>pkg:sola</code>, <code>pkg:sola-browser</code>, and
            <code>pkg:sola-design</code>. Not there yet:
        </p>
        <ul>
            <li>Releases of its own. x86-64 is the only platform.</li>
            <li>Other systems. Sola is built and packaged for Oath.</li>
            <li>Complete applications. Each has gaps, and the capability list names them.</li>
            <li>
                A lock screen. The desk starts signed in;
                <a href="/manual#security">Security</a> lists each way in and how to close it.
            </li>
        </ul>
        <p>
            The work under way is in
            <a href={"{repository}/blob/next/CURRENT.md"}>CURRENT.md</a>, and what each
            part can do in
            <a href={"{repository}/blob/next/docs/capabilities.md"}>docs/capabilities.md</a>.
        </p>
    </section>
}

fn buildLines() -> Array<Line> {
    [
        Line(command: "git clone -b next https://github.com/moonlight-pm/Sola", note: ""),
        Line(command: "cd Sola", note: ""),
        Line(command: "cargo make oath stage  ", note: "# build the three packages under target/oath"),
        Line(command: "cargo make oath apply  ", note: "# stage, store, pin, and apply them"),
    ]
}

fn building() -> Node {
    <section id="building">
        <h2>Building</h2>
        <p>
            Sola builds on an Oath machine with the desk profile, on x86-64 with an AMD
            GPU. Oath supplies the compositor, the browser
            engine (<code>pkg:cef</code>), and the graphics stack as packages; Sola's
            packages run as Oath services, and <code>oath apply</code> restarts them
            when a package moves. From a clone:
        </p>
        <pre><code>{for line in buildLines() { codeLine(line) }}</code></pre>
        <p>
            <code>oath undo</code> goes back a generation. The
            <a href="/manual#architecture">manual</a> covers the processes of a session,
            the bus, the call plane, and the command line.
        </p>
    </section>
}
