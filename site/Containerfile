# sola.moonlight.pm.
#
# The site is a Thoxa program. /manual renders docs/manual, copied in, so an
# image serves the manual of the commit it was built from. Thoxa's compiler,
# runtime, and std come from a second build context, a Thoxa checkout, so an
# image runs the Thoxa of that checkout's working tree. The image builds the
# compiler, emits the site's C, and compiles that C with thoxa_rt. Both bases
# are pinned by digest (bump them by hand); the final stage installs nothing.
# The server runs as nobody and, as PID 1, ends on SIGTERM.
#
# From the Sola repo root, with Thoxa checked out beside it:
#
#   podman build -f site/Containerfile --ignorefile site/.containerignore \
#     --build-context thoxa=../Thoxa \
#     -t sola-landing:latest -t registry.wicket.cloud/sola-landing:latest .
#
# Wicket injects PORT / WICKET_PORT_HTTP.
#   podman run --rm -p 8080:8080 sola-landing:latest

FROM docker.io/library/rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build
WORKDIR /build
COPY --from=thoxa Cargo.toml Cargo.lock ./
COPY --from=thoxa .cargo .cargo
COPY --from=thoxa crates crates
COPY --from=thoxa runtime runtime
COPY --from=thoxa std std
RUN cargo build --release --locked -p thoxa
# Same flags as the thoxa driver: -fwrapv makes Int64 overflow wrap.
RUN gcc -std=c11 -O2 -fwrapv -fPIC -c runtime/src/thoxa_rt.c -I runtime/include -o thoxa_rt.o
COPY site site
RUN target/rust/release/thoxa emit-c site \
 && gcc -std=c11 -O2 -fwrapv target/thoxa/c/site.c thoxa_rt.o -I runtime/include -lm -o /sola-site

FROM docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
COPY --from=build /sola-site /usr/local/bin/sola-site
COPY site/web /app/web
COPY docs/manual /app/manual
RUN chmod 0755 /usr/local /usr/local/bin /usr/local/bin/sola-site
USER 65534:65534
ENV THOXA_PORT=8080
ENV THOXA_STATIC=/app/web
ENV THOXA_MANUAL=/app/manual
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sola-site"]
