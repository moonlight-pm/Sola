+/// Send pointer_position without starting a manage sequence.
+/// Motion alone must not dirty windowing (protocol); tools like sola-scope
+/// still need live layout coordinates.
+pub fn sendLivePointerPosition(seat: *Seat) void {
+    const seat_v1 = seat.object orelse return;
+    if (seat_v1.getVersion() < 2) return;
+    const x = math.lossyCast(i32, seat.cursor.wlr_cursor.x);
+    const y = math.lossyCast(i32, seat.cursor.wlr_cursor.y);
+    if (x == seat.wm_sent.x and y == seat.wm_sent.y) return;
+    seat_v1.sendPointerPosition(x, y);
+    seat.wm_sent.x = x;
+    seat.wm_sent.y = y;
+}
