+/* Paint software cursors onto an already-rendered buffer (after precommit). */
+bool output_blit_software_cursors(struct wlr_output *output, struct wlr_buffer *buffer) {
+	if (output->renderer == NULL || buffer == NULL) {
+		return true;
+	}
+	bool any = false;
+	struct wlr_output_cursor *cursor;
+	wl_list_for_each(cursor, &output->cursors, link) {
+		if (cursor->enabled && cursor->visible &&
+				output->hardware_cursor != cursor && cursor->texture != NULL) {
+			any = true;
+			break;
+		}
+	}
+	if (!any) {
+		return true;
+	}
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(output->renderer, buffer, NULL);
+	if (pass == NULL) {
+		return false;
+	}
+	wlr_output_add_software_cursors_to_render_pass(output, pass, NULL);
+	return wlr_render_pass_submit(pass);
+}
