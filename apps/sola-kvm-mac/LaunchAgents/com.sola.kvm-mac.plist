<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  sola-kvm-mac LaunchAgent — GUI login session (NOT SSH / not system daemon).

  Install (as the logged-in GUI user on ember):
    apps/sola-kvm-mac/scripts/install-launchagent.sh

  Unload:
    launchctl bootout gui/$(id -u)/com.sola.kvm-mac

  Logs: ~/Library/Logs/sola-kvm-mac.{out,err}.log

  Prefer install via scripts/install.sh (signed .app). Accessibility should
  be granted to SolaKvmMac.app / com.sola.kvm-mac once; re-signing with the
  same Apple Development identity keeps the grant across rebuilds.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sola.kvm-mac</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/SolaKvmMac.app/Contents/MacOS/sola-kvm-mac</string>
    <string>listen</string>
    <string>--bind</string>
    <string>0.0.0.0:4242</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- Higher CPU priority for inject under desktop load (lower Nice = more CPU). -->
  <key>Nice</key>
  <integer>-10</integer>
  <key>LowPriorityIO</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/joshua/Library/Logs/sola-kvm-mac.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshua/Library/Logs/sola-kvm-mac.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>
</dict>
</plist>
