/target
/.worktrees
/.superpowers
/.serena

# Isolated workspace-exclude crates have their own target/ + Cargo.lock
# next to their Cargo.toml (cargo's default for non-workspace manifests).
crates/*/target/
crates/*/Cargo.lock

# nix-build result symlinks
/result
/result-*

# Local font stash (SF Pro, etc.) — binaries only; README is tracked
.local/fonts/**
!.local/fonts/README.md
