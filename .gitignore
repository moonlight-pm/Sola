/target
/.worktrees
/.claude/worktrees
/.superpowers
/.serena

# Isolated workspace-exclude crates have their own target/ + Cargo.lock
# next to their Cargo.toml (cargo's default for non-workspace manifests).
crates/*/target/
crates/*/Cargo.lock

# The site's build (site/README.md)
/site/target
/site/dist
/site/node_modules
/site/.cloudflare
/site/.wrangler

# nix-build result symlinks
/result
/result-*

# Local distribution image products (qcow2, stage trees, QEMU overlays)
/var/images/

# Local font stash (SF Pro, etc.) — binaries only; README is tracked
.local/fonts/**
!.local/fonts/README.md
